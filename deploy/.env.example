# Copy to /opt/kickoff/.env on the server (chmod 600). Never commit real values.

# Docker Hub image, without a tag.
IMAGE=<dockerhub-user>/kickoff-tactics

# Host name whose DNS A record points at this server.
API_DOMAIN=api.example.com

# Long random string, the same value as PROXY_SECRET in Cloudflare Pages.
# Generate with: openssl rand -hex 32
PROXY_SECRET=

# The site's address (Cloudflare Pages or your own domain).
ALLOWED_ORIGINS=https://<project>.pages.dev
PUBLIC_URL=https://<project>.pages.dev

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=footy

# Mail. Without SMTP_HOST the confirmation and reset links only appear in the server log.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Kickoff Tactics <no-reply@example.com>
