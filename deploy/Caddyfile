# API_DOMAIN sits behind the Cloudflare proxy (orange cloud), which holds the
# public certificate and renews it. Caddy encrypts the Cloudflare-to-server hop
# with a certificate from its own internal CA, renewed by Caddy itself, so
# nothing is ever renewed by hand. Cloudflare SSL/TLS mode must be "Full".
#
# Only the Cloudflare Pages function knows PROXY_SECRET, so the Go server is
# reachable through the site and nowhere else. That is what makes it safe to
# trust the client address the function passes along.
{$API_DOMAIN} {
	tls internal

	@site header X-Proxy-Secret {$PROXY_SECRET}

	handle @site {
		# Requests alternate between the two servers. One that is down or
		# restarting is skipped, and a request that hits it is retried on the
		# other, so a deploy that replaces them one at a time drops nothing.
		reverse_proxy backend-a:8080 backend-b:8080 {
			lb_policy round_robin
			lb_try_duration 5s
			lb_try_interval 250ms
			health_uri /healthz
			health_interval 3s
			health_timeout 2s
			fail_duration 10s

			header_up X-Forwarded-For {http.request.header.X-Client-IP}
			header_up -X-Proxy-Secret
			header_up -X-Client-IP
		}
	}

	handle {
		respond 403
	}
}
