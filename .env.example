# Copy to .env and export before starting the backend. Never commit real values.

# Leave empty for the in-memory store (state is lost on restart).
# Local Docker:  mongodb://127.0.0.1:27017
# Atlas:         mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=footy

# Loopback only by default. Put a TLS-terminating proxy in front before exposing it.
ADDR=127.0.0.1:8080

# Exact origins allowed to send state-changing requests.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true as soon as the site is served over HTTPS.
COOKIE_SECURE=false

# Mail. Leave SMTP_HOST empty to print mails (with their links) in the server log instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Kickoff Tactics <no-reply@example.com>
# Base address used in mailed links (defaults to the first allowed origin).
# PUBLIC_URL=http://localhost:5173

# Redis. Needed only when more than one server instance runs: it carries the
# "something changed" signal between instances (for WebSockets) and keeps the
# account rate limits common to all of them. Empty = single instance.
# Local Docker:  redis://127.0.0.1:6379      With a password: redis://:<password>@host:6379
REDIS_URL=

# true only behind a reverse proxy or load balancer that appends the real client
# address to X-Forwarded-For. Left false, per-IP limits use the connection's address.
TRUST_PROXY=false
